<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android App Link: Google OAuth DÖNÜŞÜ (sistem tarayıcısından app'e). Google code'u
                 https://www.tavlatv.com/auth/google/app-return?code=... adresine döner; autoVerify +
                 /.well-known/assetlinks.json ile DOĞRULANIR -> Android bu URL'i app'te açar (tarayıcı
                 değil). YALNIZ bu yola kapsamlı: sitenin diğer sayfaları app'i açmaz. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- KANONİK host www'SUZ (www.tavlatv.com -> 301 -> tavlatv.com). Google redirect + App-Link
                     doğrulaması redirect'i kabul etmez -> host = tavlatv.com (assetlinks.json burada 200). -->
                <data android:scheme="https" android:host="tavlatv.com" android:pathPrefix="/auth/google/app-return" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Fotograftan Pozisyon Analizi (/foto-analiz): WebView <input> ile kameradan foto cek / galeriden sec.
         - Kamera capture: CAMERA izni (temp dosya yukaridaki FileProvider ile; depolama izni gerekmez).
         - Galeri secimi: ACTION_GET_CONTENT / Android foto secici -> IZIN GEREKTIRMEZ. Bu yuzden
           READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE EKLENMEDI (Play "Foto/Video Izinleri" beyanindan
           kacinmak + gizlilik; tek-seferlik secim icin sistem seciciyi kullaniyoruz). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Kamera donanimi ZORUNLU DEGIL (kamerasiz cihazlar da app'i yukleyebilsin; galeriden secebilir) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
