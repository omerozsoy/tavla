APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
CSP_REPORT_ONLY=false
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.tavlatv.com,https://www.gammontv.com
CSP_ENFORCE=false

# Çoklu-domain (TEK kod + TEK DB): tavlatv.com=TR/TavlaTv, gammontv.com=EN/GammonTV.
# Marka host'tan çözülür (config/brands.php + App\Support\Brand). Origin'ler ENV ile override edilebilir.
# TAVLA_ORIGIN=https://www.tavlatv.com
# GAMMON_ORIGIN=https://www.gammontv.com
# İki markanın www+apex host'ları stateful listede olmalı (Bearer-token API'de yalnız admin oturumunu etkiler):
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1,www.tavlatv.com,tavlatv.com,www.gammontv.com,gammontv.com
# Marka başına gönderen (Resend'de domain doğrulanınca); boşsa MAIL_FROM_ADDRESS kullanılır:
# TAVLA_MAIL_FROM=noreply@tavlatv.com
# GAMMON_MAIL_FROM=noreply@gammontv.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum oturum: SLIDING (idle) süre. Token bu kadar gün HİÇ kullanılmazsa geçersiz olur;
# her aktif istekte süre ileri kayar -> aktif oyuncu (turnuva dahil) maç ortasında ASLA düşmez.
# (Eski SANCTUM_EXPIRATION=dakika SABİT süre idi, aktif kullanıcıyı da atıyordu; artık kullanılmıyor.)
SANCTUM_IDLE_DAYS=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-POSTA: üretimde Resend (API). RESEND_API_KEY Resend panelinden alınır (API Keys).
# Gönderen domaini (tavlatv.com) Resend'de DOĞRULANMIŞ olmalı (SPF+DKIM DNS kayıtları).
# RESEND_API_KEY GİZLİ — repoya YAZMA, yalnız üretim .env'ine gir.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@tavlatv.com"  # Resend'de doğrulanmış gönderen
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- TavlaTv'ye ozel ---
# Eski client tam-state PUT uyumluluk yolu. Production'da kapali kalmali.
ALLOW_LEGACY_STATE=false

# Yonetici e-postalari (virgulle ayrilir). Bu hesaplar admin sayilir.
# ONEMLI: kaynak koda gomulu admin YOK -> uretimde bunu MUTLAKA doldur,
# yoksa hicbir hesap config-admin olmaz (Filament panel/API admin uclari kapali).
ADMIN_EMAILS=

# Google Sign-In istemci kimligi (gizli degildir; ID token dogrulamasi icin).
GOOGLE_CLIENT_ID=

# Garanti Sanal POS 3D odeme (uretimde banka verir). Bos ise odeme "yapilandirilmadi".
# Once TEST bilgileriyle GARANTI_MODE=TEST, banka onayindan sonra canli bilgilerle PROD.
# GARANTI_MODE=TEST
# GARANTI_MERCHANT_ID=
# GARANTI_TERMINAL_ID=
# GARANTI_PROV_USER=PROVAUT
# GARANTI_TERMINAL_USER=PROVAUT
# GARANTI_PROV_PASSWORD=
# GARANTI_STORE_KEY=
# GARANTI_HASH_VERSION=v2
# Banka test'te txnamount'un HER ZAMAN dolu geldigi dogrulaninca true yap:
# o zaman bos/uyumsuz tutar odemeyi reddeder (varsayilan false: bos loglanir, akis surer).
# Banka callback'inde txnamount zorunlu olsun (güvenli varsayılan).
# Yalnızca doğrulanmış test entegrasyonunda geçici olarak false yapılabilir.
GARANTI_STRICT_AMOUNT=true

# ---- GNU Backgammon analiz havuzları (gnubg-service; bkz gnubg-service/README.md) --------------
# Tüm instance'lar 127.0.0.1'de ayrı systemd birimi olarak koşar (gnubg-analysis, -heavy, -3..-14
# = portlar 8092..8105). Havuz ataması SADECE bu listelerle yapılır; porttan systemd birimine
# eşleme: 8092=gnubg-analysis, 8093=gnubg-analysis-heavy, diğerleri=gnubg-analysis-(port-8091).
# GNUBG_SECRET backend + tüm systemd unit'lerde AYNI olmalı. Düzenleyince PHP-FPM reload gerekir.
#
# ÜÇ ROL-BAZLI HAVUZ (admin "Servis Durumu" panelinde ayrı gruplar):
#  1) Canlı YZ (bot) : GNUBG_URL (birincil) + GNUBG_URL_BACKUP (yedekler)
#  2) Maç sonu PR    : GNUBG_ANALYSIS_URLS  <-- maç-sonu PR darboğazı; önerilen 6 instance
#  3) Mat/ağır analiz: GNUBG_HEAVY_URLS
# Her havuz diğerine SON ÇARE failover eder. İzolasyon amacı: ağır PR analizi canlı botu bloklamasın.
GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
# GNUBG_URL=http://127.0.0.1:8092
# Canlı YZ yedekleri (bota 4 instance yeter: 8092+8093+8104+8105):
# GNUBG_URL_BACKUP=http://127.0.0.1:8093,http://127.0.0.1:8104,http://127.0.0.1:8105
# Maç sonu PR havuzu — ÖNERİLEN 6 instance (eski 2 -> darboğaz; AnalyzeMatchPrJob dedupe ile birlikte):
# GNUBG_ANALYSIS_URLS=http://127.0.0.1:8094,http://127.0.0.1:8095,http://127.0.0.1:8096,http://127.0.0.1:8097,http://127.0.0.1:8102,http://127.0.0.1:8103
# Mat/ağır analiz havuzu:
# GNUBG_HEAVY_URLS=http://127.0.0.1:8098,http://127.0.0.1:8099,http://127.0.0.1:8100,http://127.0.0.1:8101
# Instance -> systemd birim eşlemesi (restart/izleme için; bases SIRASIYLA):
# GNUBG_UNITS=gnubg-analysis,gnubg-analysis-heavy,gnubg-analysis-3,gnubg-analysis-4,gnubg-analysis-5,gnubg-analysis-6,gnubg-analysis-7,gnubg-analysis-8,gnubg-analysis-9,gnubg-analysis-10,gnubg-analysis-11,gnubg-analysis-12,gnubg-analysis-13,gnubg-analysis-14
# Maç-sonu PR otoriter (gösterilen PR = gnubg): off | shadow | authoritative
# GNUBG_PR_MODE=authoritative
# AĞIR INSTANCE DERİN İZLEME: services:watch ağır havuzu (reviewmatch/matchluck) GERÇEK motor
# probe'uyla izler -> 'analyse match' yolundaki SEGV'i yakalar (/health YETMEZ: motor çökse de HTTP
# 200 döner; 8098'in 7 saat sessiz crash-loop'u tam buydu). OPT-IN: motor SAĞLIKLIYKEN aç (SEGV
# crash-loop sırasında açmak e-posta seline yol açar). Motor stabil -> 1 yap + FPM reload.
# GNUBG_WATCH_HEAVY=1
