# onnxruntime-web icin .wasm dogru MIME tipiyle servis edilmeli (sinir agi)
AddType application/wasm .wasm

# index.html HER ZAMAN taze cekilmeli. Deploy'da asset hash'leri (index-XXX.js ...) degisir ve
# eskileri silinir; bayat index.html silinmis chunk'lara isaret edip "sayfa acilmiyor / refresh
# edilemiyor" hatasi yapar. Hash'li /assets icerik-adresli oldugu icin uzun cache guvenli.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?|wasm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Kok istegi (/) once React index.html'i dogrudan servis etsin (Laravel kurulmadan da acilir).
# /api/* yine Laravel'e gider.
DirectoryIndex index.html index.php

# ================== BAKIM MODU ==================
# Aktif etmek: backend/public/maintenance.on adli BOS dosyayi olustur.
# Kapatmak: o dosyayi SIL. (Deploy/kod gerekmez; aninda etkili.)
# Bayrak varken /admin, /panel ve bakim sayfasi HARIC tum istekler -> 503 + logolu maintenance.html.
ErrorDocument 503 /maintenance.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # --- Bakim modu bayrak-kurali (maintenance.on varsa) ---
    RewriteCond %{DOCUMENT_ROOT}/maintenance.on -f
    RewriteCond %{REQUEST_URI} !^/maintenance\.html$
    RewriteCond %{REQUEST_URI} !^/favicon\.
    RewriteCond %{REQUEST_URI} !^/admin
    RewriteCond %{REQUEST_URI} !^/panel
    RewriteRule ^ - [R=503,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
