# onnxruntime-web icin .wasm dogru MIME tipiyle servis edilmeli (sinir agi)
AddType application/wasm .wasm

# index.html HER ZAMAN taze cekilmeli. Deploy'da asset hash'leri (index-XXX.js ...) degisir ve
# eskileri silinir; bayat index.html silinmis chunk'lara isaret edip "sayfa acilmiyor / refresh
# edilemiyor" hatasi yapar. Hash'li /assets icerik-adresli oldugu icin uzun cache guvenli.
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2?|wasm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # COOP burada SET EDILMEZ. COOP tek kaynaktan (nginx additional directives) verilir; birden
    # fazla katman (nginx + .htaccess + middleware) ayni basligi eklerse tarayici coklu COOP'u
    # GECERSIZ sayar ve GSI "would block the window.postMessage" uyarisi doner. Tek nginx satiri
    # 'same-origin-allow-popups' hem kok '/' hem proxied rotalari kapsar.

    # Content-Security-Policy ENFORCING olarak burada set edilir (nginx add_header bu Plesk
    # kurulumunda uzun degeri ~199 baytta KESIYOR -> style-src/frame-src dusuyor -> Google font +
    # GSI iframe bloklaniyor. Apache Header uzun degeri kesmeden tasir, hem statik kok '/' hem tum
    # rotalar hem /admin bu blok kapsaminda). 'unsafe-eval' = Filament/Alpine.js sart; wildbg WASM
    # icin 'wasm-unsafe-eval'; fonts.bunny.net = Filament fontu. worker-src 'self' blob:
    # = Filament FileUpload (FilePond) resim onizlemesini blob web worker ile uretir; worker-src
    # yoksa default-src 'self'e duser, blob: worker BLOKLANIR -> panelde resim onizlemesi gri kutu
    # kalir (yuklenen galeri gorselleri gorunmez). Ayrica onnxruntime-web thread worker'i icin de gerekli.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; worker-src 'self' blob:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval' https://accounts.google.com https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.bunny.net https://accounts.google.com; font-src 'self' https://fonts.gstatic.com https://fonts.bunny.net data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.tavlatv.com https://validator.tavlatv.com https://accounts.google.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://stats.g.doubleclick.net https://www.google.com; frame-src 'self' https://accounts.google.com https://td.doubleclick.net https://www.googletagmanager.com"
</IfModule>

# Kok istegi (/) once React index.html'i dogrudan servis etsin (Laravel kurulmadan da acilir).
# /api/* yine Laravel'e gider.
DirectoryIndex index.html index.php

# ================== BAKIM MODU ==================
# Aktif etmek: backend/public/maintenance.on adli BOS dosyayi olustur.
# Kapatmak: o dosyayi SIL. (Deploy/kod gerekmez; aninda etkili.)
# Bayrak varken /admin, /panel ve bakim sayfasi HARIC tum istekler -> 503 + logolu maintenance.html.
ErrorDocument 503 /maintenance.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # --- Eski domain -> yeni domain (kalici 301): tavlai.com / www.tavlai.com -> www.tavlatv.com ---
    # Geciste eski adrese gelen tum istekler (SEO + yer imleri) yeni domaine tasinir.
    RewriteCond %{HTTP_HOST} ^(www\.)?tavlai\.com$ [NC]
    RewriteRule ^ https://www.tavlatv.com%{REQUEST_URI} [L,R=301]

    # --- Bakim modu bayrak-kurali (maintenance.on varsa) ---
    # /admin ve /panel'in yaninda panelin CALISMASI icin gereken yollar da HARIC tutulmali:
    #   - gercek dosyalar (-f): Filament CSS/JS (public/css/filament, public/js/filament), ikon, gorsel
    #   - /livewire: Livewire JS (livewire.js) + AJAX ucu (/livewire/update) — "Kaydet" bunu kullanir
    # Aksi halde /admin acilir ama stilsiz+olu kalir, bakim modunu KAPATAN toggle calismaz.
    RewriteCond %{DOCUMENT_ROOT}/maintenance.on -f
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/maintenance\.html$
    RewriteCond %{REQUEST_URI} !^/favicon\.
    RewriteCond %{REQUEST_URI} !^/admin
    RewriteCond %{REQUEST_URI} !^/panel
    RewriteCond %{REQUEST_URI} !^/livewire
    RewriteRule ^ - [R=503,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
