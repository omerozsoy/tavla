[Unit]
Description=Tavla review warmup worker (Analiz gnubg review önbellek — AYRI kuyruk)
After=network.target mariadb.service mysqld.service

[Service]
Type=simple
# ÖNEMLİ: vhost sistem kullanıcısı olmalı (tavla-queue.service ile AYNI kullanıcı).
#   stat -c '%U' /var/www/vhosts/tavlatv.com/httpdocs
# ve CHANGE_ME_VHOST_USER yerine yaz.
User=CHANGE_ME_VHOST_USER
WorkingDirectory=/var/www/vhosts/tavlatv.com/httpdocs/backend
# YALNIZ 'reviews' kuyruğunu işler -> CANLI maç-sonu review ısıtma (CacheMatchReviewJob, onQueue('reviews')).
# Böylece canlı review, geçmiş-maç backfill'inin arkasında BEKLEMEZ; gnubg HEAVY havuzunda koşar.
# --max-time=3600 + Restart=always -> stale kod en fazla ~1 saat yaşar. tries=1 (gnubg down -> sessiz).
#
# KUYRUK (--queue=reviews SADECE): 'reviews-bulk' + 'bulk' backfill kuyrukları AYRI worker'a taşındı
# (tavla-backfill-queue@.service). NEDEN (kök sebep, 2026-10-18: 2528 iş 8 saat attempts=0): canlı
# 'reviews' + backfill 'reviews-bulk' AYNI worker'da (eski --queue=reviews,reviews-bulk) olunca,
# queue:work KATI ÖNCELİK uygular -> 'reviews' boşalmadan 'reviews-bulk'a GEÇMEZ. Canlı review akışı
# tek worker'ı sürekli meşgul tutuyordu -> backfill sırası HİÇ gelmedi. Ayrıştırma = BQ9LW
# default-vs-bulk izolasyonunun aynısı: canlı DAİMA boşta-hazır, backfill paralel ve starve EDİLEMEZ.
ExecStart=/opt/plesk/php/8.2/bin/php artisan queue:work database --queue=reviews --sleep=3 --tries=1 --timeout=600 --max-time=3600 --max-jobs=200
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
