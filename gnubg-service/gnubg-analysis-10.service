[Unit]
Description=GNU Backgammon ADANMIS AGIR analiz YEDEGI (:8101 — heavy havuzu #4)
After=network.target
# Adanmis heavy havuzunun 4. instance'i (:8098,:8099,:8100 ile AYNI kod, AYRI port). 4 dedike heavy
# -> es-zamanli 4 Mat Analiz review paralel kosar + biri/birkaci down olsa bile calisir (SPOF yok).
# backend/.env: GNUBG_HEAVY_URLS listesine http://127.0.0.1:8101 ekle + GNUBG_UNITS'e ekle.
# CRASH-LOOP KORUMASI (2026-10-10): det. kisir dongu (SEGV her istekte) 5dk-20 deneme sonra failed.
# GUVENLI: matchluck failover + services:watch gercek motor probe ile yakalanir -> restart + alarm.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# GNUBG_SECRET diger instance'lar + backend .env ile AYNI olmali. SADECE port farkli.
Environment=GNUBG_PORT=8101
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3
# A-26: her instance kendi /tmp'si (paylaşılan geçici dosya çakışması yok) + yetki yükseltme yok.
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
