[Unit]
Description=GNU Backgammon CANLI bot havuzu genisletme (:8103 — Yapay Zeka ile Oyna #6)
After=network.target
# CANLI YZ maci ON havuzunun genisletmesi (8092/8093/8096/8097 ile AYNI kod, AYRI port). Amac:
# es-zamanli cok "Yapay Zeka ile Oyna" maci VEYA test turnuvasi kosarken bot hamlesi bekletilmesin
# -> bot-unavailable/forfeit kaynagi kesilir. backend/.env: GNUBG_URL_BACKUP listesine
# http://127.0.0.1:8103 ekle + GNUBG_UNITS'e gnubg-analysis-12. (Insan-vs-insan maclari gnubg
# KULLANMAZ; bu havuz yalnizca YZ maci + PR/analiz failover icindir.)
# CRASH-LOOP KORUMASI (2026-10-10): det. kisir dongu (SEGV her istekte) 5dk-20 deneme sonra failed.
# GUVENLI: matchluck failover + services:watch gercek motor probe ile yakalanir -> restart + alarm.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# GNUBG_SECRET diger tum instance'lar + backend .env ile AYNI olmali. SADECE port farkli.
Environment=GNUBG_PORT=8103
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3
# A-26: her instance kendi /tmp'si (paylaşılan geçici dosya çakışması yok) + yetki yükseltme yok.
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
