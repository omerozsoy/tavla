[Unit]
Description=GNU Backgammon analiz servisi #3 (PR/bot FAILOVER yedeği :8094)
After=network.target
# CANLI bot (:8092) + heavy (:8093) ile AYNI kod, AYRI instance (:8094). Amaç: PR + canlı bot
# analyze() FAILOVER havuzuna 3. instance -> biri düşse/restart olsa bile PR "—" kalmaz.
# backend/.env: GNUBG_URL_BACKUP listesine http://127.0.0.1:8094 ekle + GNUBG_UNITS'e gnubg-analysis-3.
StartLimitIntervalSec=0

[Service]
Type=simple
# GNUBG_SECRET diğer instance'lar + backend .env ile AYNI olmalı. SADECE port farklı.
Environment=GNUBG_PORT=8094
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
