[Unit]
Description=GNU Backgammon analiz servisi #4 (PR/bot FAILOVER yedeği :8095)
After=network.target
# CANLI bot (:8092) + heavy (:8093) + #3 (:8094) ile AYNI kod, AYRI instance (:8095). PR + canlı bot
# analyze() FAILOVER havuzunun 4. instance'ı -> aynı anda 3 tanesi düşse bile PR hesaplanabilir.
# backend/.env: GNUBG_URL_BACKUP listesine http://127.0.0.1:8095 ekle + GNUBG_UNITS'e gnubg-analysis-4.
StartLimitIntervalSec=0

[Service]
Type=simple
# GNUBG_SECRET diğer instance'lar + backend .env ile AYNI olmalı. SADECE port farklı.
Environment=GNUBG_PORT=8095
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
