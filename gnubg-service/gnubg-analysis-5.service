[Unit]
Description=GNU Backgammon analiz servisi #5 (CANLI bot havuzu genisletme :8096)
After=network.target
# CANLI bot (:8092,:8093) ile AYNI kod, AYRI instance (:8096). Amac: peak_inflight=4 olcumu canli
# havuzun (2 instance) doydugunu gosterdi -> shuffle'i genislet ki bot hamleleri kilitte kuyruga
# girmesin. backend/.env: GNUBG_URL_BACKUP listesine http://127.0.0.1:8096 ekle + GNUBG_UNITS'e ekle.
# CRASH-LOOP KORUMASI (2026-10-10): det. kisir dongu (SEGV her istekte) 5dk-20 deneme sonra failed.
# GUVENLI: matchluck failover + services:watch gercek motor probe ile yakalanir -> restart + alarm.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# GNUBG_SECRET diger instance'lar + backend .env ile AYNI olmali. SADECE port farkli.
Environment=GNUBG_PORT=8096
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3
# A-26: her instance kendi /tmp'si (paylaşılan geçici dosya çakışması yok) + yetki yükseltme yok.
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
