[Unit]
Description=GNU Backgammon ADANMIS AGIR analiz YEDEGI (:8100 — heavy havuzu #3)
After=network.target
# Adanmis heavy havuzunun 3. instance'i (:8098,:8099 ile AYNI kod, AYRI port). heavyBases() shuffle
# es-zamanli review'lari havuz genelinde dagitir -> 4 instance ile aninda ~4 paralel Mat Analiz.
# backend/.env: GNUBG_HEAVY_URLS listesine http://127.0.0.1:8100 ekle + GNUBG_UNITS'e ekle.
StartLimitIntervalSec=0

[Service]
Type=simple
# GNUBG_SECRET diger instance'lar + backend .env ile AYNI olmali. SADECE port farkli.
Environment=GNUBG_PORT=8100
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
