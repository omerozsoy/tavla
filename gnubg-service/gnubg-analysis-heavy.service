[Unit]
Description=GNU Backgammon AĞIR analiz servisi (reviewmatch/analyzematch/matchluck — CANLI bottan ayrı)
After=network.target
# CANLI bot (gnubg-analysis, :8092) ile AYNI kod, AYRI instance (:8093). Amaç: uzun analiz işleri
# (Mat Analiz, maç incelemesi, luck) canlı botun gnubg process'ini BLOKLAMASIN. backend
# config/gnubg.php `heavy_url` bu porta (8093) ayarlanır; `url` 8092'de kalır.
# CRASH-LOOP KORUMASI (2026-10-10): det. kisir dongu (SEGV her istekte) 5dk-20 deneme sonra failed.
# GUVENLI: matchluck failover + services:watch gercek motor probe ile yakalanir -> restart + alarm.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# GNUBG_SECRET canlı instance + backend .env ile AYNI olmalı (backend her iki instance'a da aynı
# secret'ı gönderir). SADECE port farklı.
Environment=GNUBG_PORT=8093
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3
# A-26: her instance kendi /tmp'si (paylaşılan geçici dosya çakışması yok) + yetki yükseltme yok.
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
