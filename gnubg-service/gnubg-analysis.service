[Unit]
Description=GNU Backgammon analiz servisi (tavlai — ana motor)
After=network.target
# CRASH-LOOP KORUMASI (2026-10-10): tek seferlik çökme hâlâ self-heal olur (RestartSec=3), ama
# DETERMİNİSTİK kısır döngü (ör. 'analyse match'/matchluck SEGV her istekte tekrarlıyor) 5 dk'da 20
# denemeden sonra 'failed'a düşer. Neden GÜVENLİ: (1) matchluck artık failover'lı (tek instance SEGV
# şansı durdurmaz), (2) services:watch 'failed'ı GERÇEK motor probe'uyla yakalar -> dakikada bir
# restart dener + email/WhatsApp uyarır. Böylece 8098'in 7 saat SESSİZ ~4000 kez çöküp kalkması
# (StartLimitIntervalSec=0 yüzünden görünmez sonsuz döngü) bir daha olmaz: bounded + görünür + alarmlı.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# GNUBG_SECRET'i UZUN-RASTGELE bir değerle değiştir (backend .env ile AYNI olacak).
Environment=GNUBG_PORT=8092
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3
# A-26: her instance kendi /tmp'si (paylaşılan geçici dosya çakışması yok) + yetki yükseltme yok.
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
