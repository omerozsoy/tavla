[Unit]
Description=GNU Backgammon analiz servisi (tavlai — ana motor)
After=network.target
# Kısır döngüde (art arda çökme) systemd varsayılan olarak 10sn'de 5 denemeden sonra PES EDER ve
# birimi 'failed' bırakır -> elle "systemctl restart" gerekir. 0 = sınırı KALDIR: her çökmede
# RestartSec sonra TEKRAR başlat (kalıcı self-heal; elle müdahale gerekmez).
StartLimitIntervalSec=0

[Service]
Type=simple
# GNUBG_SECRET'i UZUN-RASTGELE bir değerle değiştir (backend .env ile AYNI olacak).
Environment=GNUBG_PORT=8092
Environment=GNUBG_SECRET=CHANGE_ME_UZUN_RASTGELE
WorkingDirectory=/opt/gnubg-service
ExecStart=/usr/local/bin/gnubg -t -q -p /opt/gnubg-service/gnubg_service.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
