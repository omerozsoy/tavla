[Unit]
Description=Tavla fotograftan pozisyon tanima servisi (TFLite gorus)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# RECOG_SECRET'i UZUN-RASTGELE bir degerle degistir (backend .env RECOG_SECRET ile AYNI olacak).
# PORT: 8120 gnubg havuzuna gitti -> recognition CANLI'da 9191 (backend .env RECOG_URL ile AYNI tut).
Environment=RECOG_PORT=9191
Environment=RECOG_SECRET=CHANGE_ME_UZUN_RASTGELE
# Modeller shared/ altinda (deploy'da silinmez) -> oraya yuklenmeli (gitignore, ~43MB).
Environment=RECOG_MODELS_DIR=/home/tavla/tavlatv.com/shared/recognition/tensor-models
WorkingDirectory=/home/tavla/tavlatv.com/current
ExecStart=/home/tavla/tavlatv.com/shared/recognition/venv/bin/python /home/tavla/tavlatv.com/current/recognition/service.py
Restart=always
RestartSec=3
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

# NOT: Uretim Forge-yonetimli -> systemd DEGIL. Forge panel > Daemons ile ekle.
# Forge daemon formunda AYRI env alani YOK -> env'i komuta inline goM (bash -c + exec):
#   Command:
#     bash -c 'RECOG_PORT=9191 RECOG_SECRET=<backend .env ile AYNI> \
#       RECOG_MODELS_DIR=/home/tavla/tavlatv.com/shared/recognition/tensor-models \
#       exec /home/tavla/tavlatv.com/shared/recognition/venv/bin/python \
#       /home/tavla/tavlatv.com/current/recognition/service.py'
#   Directory: /home/tavla/tavlatv.com/current
#   User:      tavla   |  Processes: 1
# Ilk kurulumda 9191'i tutan eski (yonetilmeyen) sureci dusur: pkill -f 'recognition/service.py'
#
# !!! DEPLOY-HOOK (ONEMLI) !!! Forge > Site > Deploy Script'in SONUNA ekle:
#   pkill -f 'recognition/service.py' || true
# Servis Python kodu bellege PROCESS BASLANGICINDA yuklenir; daemon supervisor-yonetimli oldugundan
# pkill sonrasi otomatik respawn eder (yeni release recognize.py'yi yukler). Bu satir OLMADAN
# recognize.py duzeltmeleri canliya YANSIMAZ (reboot'a kadar eski kod bellekte kalir; 2026-11-28
# renk-ters hatasinin koku tam buydu).
#
# Bu dosya referans/dokumantasyon; gercek daemon panelden kurulur.
